# Copy to .env and fill in real values for local dev.
# Nothing in this file is a real secret.

# --- App ---
PROJECT_NAME="Miles Tech Video Discovery Platform"
ENVIRONMENT=development
DEBUG=true

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# --- Database (PostgreSQL) ---
# Matches docker-compose.yml's postgres service by default. Host port is
# 5433, not 5432, to avoid colliding with a native Postgres install some
# dev machines already run on 5432 — the container-to-container port
# (used when the backend itself runs in Docker) is still 5432 internally.
DATABASE_URL=postgresql+psycopg://milestech:milestech@localhost:5433/milestech

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Auth / JWT ---
JWT_SECRET_KEY=dev-only-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=43200

# --- OTP provider (SMS/email one-time-passcode delivery) ---
# console = print OTP to backend logs for local dev, no external account needed
OTP_PROVIDER=console
OTP_SENDER_ID=
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=

# --- Search (Meilisearch, self-hosted via docker-compose for local dev) ---
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_MASTER_KEY=dev-only-change-me

# --- Managed video API (pick ONE provider; see docs/SETUP.md) ---
VIDEO_API_PROVIDER=cloudflare_stream
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=

# --- Object storage for images/docs (Cloudflare R2 or DO Spaces, S3-compatible) ---
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=miles-tech-media
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# --- M-Pesa Daraja (fast-follow, Weeks 13-18 — apply for access in Sprint 1) ---
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_BASE_URL=http://localhost:8000

# --- Monitoring ---
SENTRY_DSN=
